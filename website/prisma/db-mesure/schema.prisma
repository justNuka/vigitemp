generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/@prisma-db-mesure"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_MESURE_URL")
}

model tm_graphique {
  Id_Graphique            Int
  Date_Heure_Mesure       DateTime @default(now()) @db.DateTime(0)
  Valeur                  Float?   @db.Float
  Valeur_Brute            Float?   @db.Float
  Nb_Decimal              Int?
  Consigne                Float?   @db.Float
  Consigne_Sup            Float?   @db.Float
  Consigne_Inf            Float?   @db.Float
  Unite                   String?  @db.VarChar(10)
  Sonde_Numero_Serie      String?  @db.VarChar(50)
  Id_Sonde                Int?
  Id_Lieu                 Int
  Est_Valeur_Null         Boolean  @default(false)
  Frequence               Int?
  Est_Etat_Alarme         Int      @default(0) @db.TinyInt
  Consigne_Inf_Pre_Alarme Float?   @db.Float
  Consigne_Sup_Pre_Alarme Float?   @db.Float

  @@id([Id_Graphique, Date_Heure_Mesure, Id_Lieu, Est_Valeur_Null, Est_Etat_Alarme])
  @@index([Est_Valeur_Null], map: "IDX_Valeur_Null")
  @@index([Date_Heure_Mesure], map: "IDX_Date_Heure_Mesure")
  @@index([Est_Etat_Alarme], map: "IDX_Etat_Alarme")
  @@index([Id_Lieu], map: "IDX_Id_Lieu")
  @@index([Id_Sonde, Date_Heure_Mesure(sort: Desc)], map: "IDX_Id_Sonde_Date_Heure_Mesure")
}

model tm_journal {
  Id_Serveur_BDD          Int
  Id_Journal              Int
  Code_Journal            String?   @db.VarChar(50)
  Commentaire             String?   @db.LongText
  Nom_Utilisateur         String?   @db.VarChar(50)
  Profil_Utilisateur      String?   @db.VarChar(50)
  Date_Heure_Journal      DateTime? @db.DateTime(0)
  Id_Lieu                 Int?
  Commentaire_Utilisateur String?   @db.LongText

  @@id([Id_Serveur_BDD, Id_Journal])
  @@index([Code_Journal], map: "IDX_Code_Journal")
  @@index([Date_Heure_Journal], map: "IDX_Date_Heure_Journal")
  @@index([Nom_Utilisateur], map: "IDX_Nom_Utilisateur")
  @@index([Profil_Utilisateur], map: "IDX_Profil_Utilisateur")
}

model tm_journal_code {
  Code_Journal String  @id @db.VarChar(50)
  Commentaire  String? @db.VarChar(200)
}

model tm_compteur_id_table {
  Id_Serveur_BDD Int
  Nom_Table      String @db.VarChar(100)
  Compteur_Id    Int?

  @@id([Id_Serveur_BDD, Nom_Table])
}

model tm_datalogger_mesures {
  Id_Datalogger_Mesures Int      @id
  Id_Reception          Int?
  Date_Heure_Mesure     DateTime @default(now()) @db.DateTime(0)
  Valeur                Float?   @db.Float
  Est_Hors_Consignes    Int?     @db.TinyInt
  Est_En_Alarme         Int?     @db.TinyInt
  Est_Marqueur          Int?     @db.TinyInt
  Details               String?  @db.VarChar(200)

  @@index([Date_Heure_Mesure], map: "IDX_Date_Heure_Mesure")
  @@index([Id_Reception], map: "IDX_Id_Reception")
}

model tm_mesures {
  Id_Serveur_BDD          Int      @default(0)
  Id_Mesure               Int      @default(0)
  Date_Heure_Mesure       DateTime @db.DateTime(0)
  Valeur                  Float?   @db.Float
  Valeur_Brute            Float?   @db.Float
  Nb_Decimal              Int?
  Consigne                Float?   @db.Float
  Consigne_Sup            Float?   @db.Float
  Consigne_Inf            Float?   @db.Float
  Unite                   String?  @default("") @db.VarChar(10)
  Sonde_Numero_Serie      String?  @default("") @db.VarChar(50)
  Id_Lieu                 Int      @default(0)
  Est_Valeur_Null         Boolean  @default(false) @db.TinyInt
  Frequence               Int?
  Est_Etat_Alarme         Boolean  @default(false) @db.TinyInt
  Consigne_Inf_Pre_Alarme Float?   @db.Float
  Consigne_Sup_Pre_Alarme Float?   @db.Float
  Moyenne                 Float?   @db.Float

  @@id([Id_Serveur_BDD, Id_Mesure, Date_Heure_Mesure, Id_Lieu, Est_Valeur_Null])
  @@index([Date_Heure_Mesure], map: "IDX_Date_Heure_Mesure")
  @@index([Est_Etat_Alarme], map: "IDX_Est_Etat_Alarme")
  @@index([Est_Valeur_Null], map: "IDX_Est_Valeur_Null")
  @@index([Date_Heure_Mesure, Id_Lieu], map: "IDX_Date_Heure_Mesure_Id_Lieu")
  @@index([Id_Lieu], map: "Mesure_Numero_lieu_IDX")
  @@index([Id_Lieu], map: "Mesure_lieu")
}

model tm_journal_histo {
  Id_Serveur_BDD          Int       @default(0)
  Id_Journal_Histo        Int       @default(autoincrement())
  Id_Journal              Int       @default(0)
  Code_Journal            String?   @default("") @db.VarChar(50)
  Commentaire             String?   @db.LongText
  Nom_Utilisateur         String?   @default("") @db.VarChar(50)
  Profil_Utilisateur      String?   @default("") @db.VarChar(50)
  Date_Heure_Journal      DateTime? @db.DateTime(0)
  Id_Lieu                 Int?
  Commentaire_Utilisateur String?   @db.LongText

  @@id([Id_Serveur_BDD, Id_Journal_Histo, Id_Journal])
  @@index([Code_Journal], map: "IDX_Code_Journal")
  @@index([Date_Heure_Journal], map: "IDX_Date_Heure_Journal")
  @@index([Nom_Utilisateur], map: "IDX_Nom_Utilisateur")
  @@index([Profil_Utilisateur], map: "IDX_Profil_Utilisateur")
}

model tm_mesure_calibrage {
  Id_Serveur_BDD      Int      @default(0)
  Id_Mesure_Calibrage Int      @default(autoincrement())
  Valeur              Float    @default(0) @db.Float
  Valeur_Brute        Float    @default(0) @db.Float
  Sonde_Numero_Serie  String   @default("") @db.VarChar(50)
  Est_Valeur_Null     Int      @db.TinyInt
  Date_Heure          DateTime @default(now()) @db.Timestamp(0)

  @@id([Id_Serveur_BDD, Id_Mesure_Calibrage])
  @@index([Sonde_Numero_Serie], map: "IDX_Sonde_Numero_Serie")
  @@index([Date_Heure], map: "IDX_Date_Heure")
  @@index([Valeur], map: "IDX_Valeur")
  @@index([Est_Valeur_Null], map: "IDX_Est_Valeur_Null")
  @@index([Valeur_Brute], map: "IDX_Valeur_Brute")
}

model tm_mesure_calibrage_etalon {
  Id_Serveur_BDD             Int      @default(0)
  Id_Mesure_Calibrage_Etalon Int      @default(autoincrement())
  Valeur                     Float    @default(0) @db.Float
  Valeur_Brute               Float    @default(0) @db.Float
  Etalon_Numero_Serie        String   @default("") @db.VarChar(50)
  Est_Valeur_Null            Int      @db.TinyInt
  Date_Heure                 DateTime @default(now()) @db.Timestamp(0)

  @@id([Id_Serveur_BDD, Id_Mesure_Calibrage_Etalon])
  @@index([Etalon_Numero_Serie], map: "IDX_Etalon_Numero_Serie")
  @@index([Date_Heure], map: "IDX_Date_Heure")
  @@index([Valeur], map: "IDX_Valeur")
  @@index([Est_Valeur_Null], map: "IDX_Est_Valeur_Null")
  @@index([Valeur_Brute], map: "IDX_Valeur_Brute")
}

model tm_mesure_etalon {
  Id_Serveur_BDD      Int      @default(0)
  Id_Mesure_Etalon    Int      @default(autoincrement())
  Valeur_Brute        Float    @db.Float
  Etalon_Numero_Serie String   @default("") @db.VarChar(50)
  Est_Valeur_Null     Int      @db.TinyInt
  Date_Heure          DateTime @db.DateTime(0)
  Message_Erreur      String   @default("") @db.VarChar(50)

  @@id([Id_Serveur_BDD, Id_Mesure_Etalon])
  @@index([Date_Heure], map: "IDX_Date_Heure")
  @@index([Message_Erreur], map: "IDX_Message_Erreur")
  @@index([Etalon_Numero_Serie], map: "IDX_Etalon_Numero_Serie")
  @@index([Est_Valeur_Null], map: "IDX_Est_Valeur_Null")
  @@index([Valeur_Brute], map: "IDX_Valeur_Brute")
}

model tm_mesure_etalonnage {
  Id_Serveur_BDD       Int       @default(0)
  Id_Mesure_Etalonnage Int       @default(autoincrement())
  Sonde_Numero_serie   String?   @db.VarChar(50)
  Numero_Ordre         Int?
  Mesure_Sonde         Float?    @db.Float
  Mesure_Etalon        Float?    @db.Float
  Date_Heure           DateTime? @db.DateTime(0)

  @@id([Id_Serveur_BDD, Id_Mesure_Etalonnage])
  @@index([Sonde_Numero_serie], map: "IDX_Sonde_Numero_serie")
}

model tm_mesures_histo {
  Id_Serveur_BDD          Int      @default(0)
  Id_Mesure               Int      @default(autoincrement())
  Date_Heure_Mesure       DateTime @default(now()) @db.DateTime(0)
  Valeur                  Float?   @db.Float
  Valeur_Brute            Float?   @db.Float
  Nb_decimal              Int?     @db.TinyInt
  Consigne                Float?   @db.Float
  Consigne_Sup            Float?   @db.Float
  Consigne_Inf            Float?   @db.Float
  Unite                   String?  @default("") @db.VarChar(10)
  Sonde_Numero_Serie      String?  @default("") @db.VarChar(50)
  Id_Lieu                 Int      @default(0)
  Est_Valeur_Null         Int      @default(0) @db.TinyInt
  Frequence               Int?
  Est_En_Alarme           Boolean? @default(false)
  Consigne_Inf_Pre_Alarme Float?   @db.Float
  Consigne_Sup_Pre_Alarme Float?   @db.Float
  Moyenne                 Float?   @db.Float

  @@id([Id_Serveur_BDD, Id_Mesure, Date_Heure_Mesure, Id_Lieu, Est_Valeur_Null])
  @@index([Date_Heure_Mesure], map: "IDX_Date_Heure_Mesure")
  @@index([Est_En_Alarme], map: "IDX_Est_En_Alarme")
  @@index([Est_Valeur_Null], map: "IDX_Est_Valeur_Null")
  @@index([Date_Heure_Mesure, Id_Lieu], map: "IDX_Date_Heure_Mesure_Id_Lieu")
  @@index([Id_Lieu], map: "Mesure_Numero_lieu_IDX")
  @@index([Id_Lieu], map: "Mesure_lieu")
}

model tm_mesures_test {
  Id_Serveur_BDD     Int      @default(0)
  Id_Mesure_Test     Int      @default(autoincrement())
  Valeur_Brute       Float    @db.Float
  Sonde_Numero_Serie String   @unique(map: "Sonde") @default("") @db.VarChar(50)
  Est_Valeur_Null    Int      @db.TinyInt
  Date_Heure         DateTime @default(now()) @db.Timestamp(0)
  Nombre_Total       Int      @default(0)
  Nombre_Recu        Int      @default(0)

  @@id([Id_Serveur_BDD, Id_Mesure_Test])
  @@index([Date_Heure], map: "IDX_Date_Heure")
  @@index([Est_Valeur_Null], map: "IDX_Est_Valeur_Null")
  @@index([Nombre_Recu], map: "IDX_Nombre_Recu")
  @@index([Nombre_Total], map: "IDX_Nombre_Total")
}

model tm_mesures_test_etalon {
  Id_Serveur_BDD        Int      @default(0)
  Id_Mesure_Test_Etalon Int      @default(autoincrement())
  Valeur_Brute          Float    @db.Float
  Etalon_Numero_Serie   String   @unique(map: "Etalon") @default("") @db.VarChar(50)
  Est_Valeur_Null       Int      @db.TinyInt
  Date_Heure            DateTime @default(now()) @db.Timestamp(0)
  Nombre_Total          Int      @default(0)
  Nombre_Recu           Int      @default(0)

  @@id([Id_Serveur_BDD, Id_Mesure_Test_Etalon])
  @@index([Date_Heure], map: "IDX_Date_Heure")
  @@index([Est_Valeur_Null], map: "IDX_Est_Valeur_Null")
  @@index([Nombre_Recu], map: "IDX_Nombre_Recu")
  @@index([Nombre_Total], map: "IDX_Nombre_Total")
}

model tm_mode_degrade {
  Id_Mode_Degrade     Int       @id @default(autoincrement())
  Id_Utilisateur      Int?
  Date_Heure_Creation DateTime? @db.DateTime(0)
  Requete_SQL         String?   @db.VarChar(500)
  Est_Archivee        Boolean   @default(false)
  Date_Heure_Archive  DateTime? @db.DateTime(0)
}

model tm_parametre {
  Cle_Parametre         String  @default("") @db.VarChar(20)
  Id_Parametre          Int     @default(autoincrement())
  Valeur_Parametre      String? @db.VarChar(50)
  Groupe_Parametre      String? @db.VarChar(50)
  Commentaire_Parametre String? @db.VarChar(100)

  @@id([Cle_Parametre, Id_Parametre])
}
