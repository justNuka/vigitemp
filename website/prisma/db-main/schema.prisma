/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model t_alarme_message {
  IdAlarmeMessage   Int     @id @default(autoincrement())
  CodeAlarmeMessage String? @unique(map: "CodeAlarmeMessage") @db.VarChar(20)
  Type              String? @db.VarChar(1)
  TexteMessage      String? @db.LongText
}

model t_ancienmotpasse {
  IdAncienMotPasse Int            @id @default(autoincrement())
  IdUtilisateur    Int?
  MotDePasse       String?        @db.VarChar(32)
  t_utilisateur    t_utilisateur? @relation(fields: [IdUtilisateur], references: [IdUtilisateur], onDelete: NoAction, onUpdate: NoAction, map: "FK_UTILISATEUR_ANCIENMDP_new")

  @@index([IdUtilisateur], map: "IdUtilisateur")
}

model t_autorisation {
  IdAutorisation                Int                             @id @default(autoincrement())
