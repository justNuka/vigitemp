generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/@prisma-db-main"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model t_actionneur {
  Id_Actionneur    Int                @id @default(autoincrement())
  Num_Serie        String?            @db.VarChar(50)
  Type             Int?
  Est_Etat         Boolean?           @default(false)
  Est_Demande      Boolean?           @default(false)
  Commentaire      String?            @db.VarChar(255)
  Port_Serie       Int?
  Id_Module        Int?
  Relai_1          String?            @db.VarChar(50)
  Relai_2          String?            @db.VarChar(50)
  Relai_3          String?            @db.VarChar(50)
  Relai_4          String?            @db.VarChar(50)
  Est_Test         Boolean?           @default(false)
  Libelle_Erreur   String?            @db.VarChar(50)
  Id_Plan          Int?
  Position_Plan_X  BigInt?
  Position_Plan_Y  BigInt?
  Est_Archive      Boolean?           @default(false)
  Id_Serveur       Int?               @default(1)
  t_plan           t_plan?            @relation(fields: [Id_Plan], references: [Id_Plan], onDelete: NoAction, onUpdate: NoAction, map: "FK_PLAN_ACTIONNEUR")
  t_actionneurtype t_actionneur_type? @relation(fields: [Type], references: [Type], onDelete: NoAction, onUpdate: NoAction, map: "FK_TYPE_ACTIONNEUR")

  @@index([Est_Etat], map: "IDX_Est_Etat")
  @@index([Id_Module], map: "IDX_Id_Module")
  @@index([Id_Plan], map: "IDX_Id_Plan")
  @@index([Num_Serie], map: "IDX_Num_Serie")
  @@index([Type], map: "IDX_Type")
}

