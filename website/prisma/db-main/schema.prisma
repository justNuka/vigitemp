  t_bain             t_bain?   @relation(fields: [IdBain], references: [IdBain], onDelete: NoAction, onUpdate: NoAction, map: "FK_BAIN_CALIBRAGE")
  t_sonde            t_sonde?  @relation(fields: [SondeNumeroSerie], references: [SondeNumeroSerie], onDelete: NoAction, onUpdate: NoAction, map: "FK_SONDE_CALIBRAGE")

  @@index([DateHeureCalibrage], map: "Calibrage_Date_calibrage_IDX")
  @@index([IdBain], map: "Calibrage_IdBain_IDX")
  @@index([SondeNumeroSerie], map: "Calibrage_Numero_serie_IDX")
  @@index([SE_Num], map: "Calibrage_SE_Num_IDX")
}

model t_certif {
