  Unite              String?   @db.VarChar(10)
  Nb_Decimale        Int?      @db.TinyInt
  Operateur          String?   @db.VarChar(255)
  SE_Num             String?   @db.VarChar(50)
  SE_Oganisme        String?   @db.VarChar(50)
  SE_Date_Certif     DateTime? @db.Date
  SE_Num_Certif      String?   @db.VarChar(50)
  MesureEtalon1      String?   @db.VarChar(50)
  MesureEtalon2      String?   @db.VarChar(50)
  Resistance1        String?   @db.VarChar(50)
  Resistance2        String?   @db.VarChar(50)
  AncienneMesure1    String?   @db.VarChar(50)
  AncienneMesure2    String?   @db.VarChar(50)
