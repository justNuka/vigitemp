generator client {
  provider = "prisma-client"
  output   = "../../src/generated/@prisma-db-main"
}

// Base de données principale (vigitemp) - configuration, users, sensors, alarms, etc.
// URL configurée dans prisma.config.ts via env("DATABASE_URL")
datasource db {
  provider = "mysql"
}

// Note: Pour vigitemp_mesure (time-series), nous créerons un second schéma
// Les deux bases seront accessibles via des clients Prisma séparés

model liste_clients {
  IDClient                    Int     @id @default(2)
  Nom                         String? @default("MC2") @db.VarChar(50)
  Num_Compte                  String? @default("9633000000") @db.VarChar(50)
  VigiServ_Dernier_Date_Heure String? @db.LongText
  VigiTel_Dernier_Date_Heure  String? @db.LongText
}

model t_actionneur {
  IdActionneur     Int               @id @default(autoincrement())
  Num_Serie        String?           @db.VarChar(50)
  Type             Int?
  Etat             Boolean?          @default(false)
  Demande          Boolean?          @default(false)
  Commentaire      String?           @db.VarChar(255)
  Port_serie       Int?              @db.SmallInt
  IdModule         Int?
  Relai_1          String?           @db.VarChar(50)
  Relai_2          String?           @db.VarChar(50)
  Relai_3          String?           @db.VarChar(50)
  Relai_4          String?           @db.VarChar(50)
  Test             Boolean?          @default(false)
  Lib_Erreur       String?           @db.VarChar(50)
  IdPlan           Int?
  Position_Plan_X  BigInt?
  Position_Plan_Y  BigInt?
  Archive          Boolean?          @default(false)
  IDserveur        Int?              @default(1)
  t_module         t_module?         @relation(fields: [IdModule], references: [IdModule], onDelete: NoAction, onUpdate: NoAction, map: "FK_MODULE_ACTIONNEUR")
  t_plan           t_plan?           @relation(fields: [IdPlan], references: [IdPlan], onDelete: NoAction, onUpdate: NoAction, map: "FK_PLAN_ACTIONNEUR")
  t_actionneurtype t_actionneurtype? @relation(fields: [Type], references: [Type], onDelete: NoAction, onUpdate: NoAction, map: "FK_TYPE_ACTIONNEUR")
  t_lieu           t_lieu[]

  @@index([Etat], map: "Actionneur_Etat_IDX")
  @@index([IdModule], map: "Actionneur_IDModule_IDX")
  @@index([IdPlan], map: "Actionneur_IDPlan_IDX")
  @@index([Num_Serie], map: "Actionneur_Num_Serie_IDX")
  @@index([Type], map: "Actionneur_Type_IDX")
}

model t_actionneurtype {
  Type         Int            @id
  Description  String?        @db.VarChar(50)
  IMAGE        Bytes?
  GereRelais   Boolean?       @default(false)
  t_actionneur t_actionneur[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model t_alarme {
  IdAlarme                  Int       @id @default(autoincrement())
  DateHeureDebut            DateTime? @db.DateTime(0)
  Valeur                    Float?
  Type                      String?   @db.VarChar(1)
  DateHeureFin              DateTime? @db.DateTime(0)
  Alarme_Vrai               Boolean?  @default(false)
  IdLieu                    Int?
  SondeNumeroSerie          String?   @db.VarChar(50)
  Unite                     String?   @db.VarChar(10)
  Acquite                   Boolean?  @default(false)
  DateHeureDerniereMesure   DateTime? @db.DateTime(0)
  DateHeureDebutAlarme_Vrai DateTime? @db.DateTime(0)
  AlarmePourVigiTel         Boolean?  @default(false)
  MailEnvoye                Boolean?
  TelAcquite                Boolean?
  t_lieu                    t_lieu?   @relation(fields: [IdLieu], references: [IdLieu], onDelete: NoAction, onUpdate: NoAction, map: "FK_LIEU_ALARME")

  @@index([Acquite], map: "Alarme_Acquite_IDX")
  @@index([Alarme_Vrai], map: "Alarme_Alarme_Vrai_IDX")
  @@index([DateHeureDebut], map: "Alarme_Date_Heure_Alarme_IDX")
  @@index([DateHeureFin], map: "Alarme_Date_Heure_Fin_Alar_IDX")
  @@index([DateHeureDebutAlarme_Vrai], map: "Alarme_Date_heure_Debut_Al_IDX")
  @@index([DateHeureDerniereMesure], map: "Alarme_Date_heure_Derniere_IDX")
  @@index([SondeNumeroSerie], map: "Alarme_Num_Sonde_IDX")
  @@index([IdLieu], map: "Alarme_Numero_lieu_IDX")
  @@index([Type], map: "Alarme_Type_Alarme_IDX")
  @@index([Unite], map: "Alarme_Unite_IDX")
  @@index([Valeur], map: "Alarme_Valeur_IDX")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model t_alarme_archive {
  IdAlarme                Int       @id @default(autoincrement())
