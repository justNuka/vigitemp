  Relai_2          String?            @db.VarChar(50)
  Relai_3          String?            @db.VarChar(50)
  Relai_4          String?            @db.VarChar(50)
  Est_Test         Boolean?           @default(false)
  Libelle_Erreur   String?            @db.VarChar(50)
  Id_Plan          Int?
  Position_Plan_X  BigInt?
  Position_Plan_Y  BigInt?
  Est_Archive      Boolean?           @default(false)
  Id_Serveur       Int?               @default(1)
