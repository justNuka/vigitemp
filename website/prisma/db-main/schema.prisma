  Archive      Boolean?       @default(false)
  t_calibrage  t_calibrage[]
  t_etalonnage t_etalonnage[]

  @@index([Model], map: "Bain_Model_IDX")
  @@index([Reference], map: "Bain_Reference_IDX")
}

model t_calibrage {
  DateHeureCalibrage DateTime? @db.DateTime(0)
  IdCalibrage        Int       @id @default(autoincrement())
  SondeNumeroSerie   String?   @db.VarChar(50)
