  @@index([DateHeureArchiveAlarme], map: "Alarme_Date_heure_Debut_Al_IDX")
  @@index([DateHeureDerniereMesure], map: "Alarme_Date_heure_Derniere_IDX")
  @@index([SondeNumeroSerie], map: "Alarme_Num_Sonde_IDX")
  @@index([IdLieu], map: "Alarme_Numero_lieu_IDX")
  @@index([Type], map: "Alarme_Type_Alarme_IDX")
  @@index([Unite], map: "Alarme_Unite_IDX")
  @@index([Valeur], map: "Alarme_Valeur_IDX")
