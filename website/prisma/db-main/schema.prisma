generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/@prisma-db-main"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model t_actionneur {
  Id_Actionneur    Int                @id @default(autoincrement())
  Num_Serie        String?            @db.VarChar(50)
  Type             Int?
  Etat             Boolean?           @default(false)
  Demande          Boolean?           @default(false)
  Commentaire      String?            @db.VarChar(255)
  Port_Serie       Int?
  Id_Module        Int?
  Relai_1          String?            @db.VarChar(50)
  Relai_2          String?            @db.VarChar(50)
  Relai_3          String?            @db.VarChar(50)
  Relai_4          String?            @db.VarChar(50)
  Test             Boolean?           @default(false)
  Libelle_Erreur   String?            @db.VarChar(50)
  Id_Plan          Int?
  Position_Plan_X  BigInt?
  Position_Plan_Y  BigInt?
  Archive          Boolean?           @default(false)
  Id_Serveur       Int?               @default(1)
  t_plan           t_plan?            @relation(fields: [Id_Plan], references: [IdPlan], onDelete: NoAction, onUpdate: NoAction, map: "FK_PLAN_ACTIONNEUR")
  t_actionneurtype t_actionneur_type? @relation(fields: [Type], references: [Type], onDelete: NoAction, onUpdate: NoAction, map: "FK_TYPE_ACTIONNEUR")

  @@index([Etat], map: "Actionneur_Etat_IDX")
  @@index([Id_Module], map: "Actionneur_IDModule_IDX")
  @@index([Id_Plan], map: "Actionneur_IDPlan_IDX")
  @@index([Num_Serie], map: "Actionneur_Num_Serie_IDX")
  @@index([Type], map: "Actionneur_Type_IDX")
}

