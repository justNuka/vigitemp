  @@index([Acquite], map: "Alarme_Acquite_IDX")
  @@index([Alarme_Vrai], map: "Alarme_Alarme_Vrai_IDX")
  @@index([DateHeureDebut], map: "Alarme_Date_Heure_Alarme_IDX")
