# OVH SIP line credentials. Never commit the real .env file.
OVH_SIP_USERNAME=0033XXXXXXXXX
OVH_SIP_AUTH_USERNAME=0033XXXXXXXXX
OVH_SIP_PASSWORD=CHANGE_ME
OVH_SIP_DOMAIN=sip-domain.io
OVH_SIP_OUTBOUND_PROXY=your-group.sip-proxy.io

# Asterisk uses Docker host networking on Linux to avoid an extra SIP/RTP NAT layer.
# Set the site's public IPv4 and the actual LAN CIDR of the Asterisk host.
# If the site is behind NAT, forward only SIP/RTP ports required by the PoC at the router/firewall
# and restrict their sources to the OVH telephony infrastructure when your network equipment allows it.
ASTERISK_EXTERNAL_ADDRESS=203.0.113.10
ASTERISK_LOCAL_NET=192.168.1.0/24

# ARI is for VigiSensys only. Keep port 8088 restricted to the LAN/VigiSensys host and never forward it publicly.
ASTERISK_ARI_USERNAME=vigisensys
ASTERISK_ARI_PASSWORD=CHANGE_ME_TOO

# Offline test message generated with espeak-ng when the container starts.
VIGISENSYS_TEST_MESSAGE=Ceci est un appel de test VigiSensys.
