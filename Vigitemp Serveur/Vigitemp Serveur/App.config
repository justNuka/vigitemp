<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- Base URL of the Next.js website (example: http://127.0.0.1:3000) -->
    <add key="Vigi.WebsiteBaseUrl" value="http://127.0.0.1:3000" />
    <!-- Must match VIGITEMP_ALARM_DISPATCH_SECRET on the website -->
    <add key="Vigi.AlarmDispatchSecret" value="" />
    <!-- Monthly statistics recap trigger (server -> website /api/statistiques/recap-mensuel/send) -->
    <add key="Vigitemp.StatsMonthlyDispatch.Enabled" value="true" />
    <add key="Vigitemp.StatsMonthlyDispatch.ServerId" value="1" />
    <add key="Vigitemp.StatsMonthlyDispatch.IntervalMinutes" value="60" />

    <!-- Alarm evaluation policy (defaults preserve legacy behavior) -->
    <add key="Vigi.License.HysteresisDelta" value="0" />
    <add key="Vigi.License.DebounceSeconds" value="0" />
    <!-- If false: do not display alarms while snoozed (only after reactivation). -->
    <add key="Vigi.License.ShowWhileSnoozed" value="true" />
    <!-- Cache duration for alarm settings (seconds). -->
    <add key="Vigi.License.SettingsCacheSeconds" value="60" />

    <!-- Detailed metrology logs (apply/cache). false = quieter logs -->
    <add key="Vigitemp.Metrology.LogDetailed" value="false" />

    <!-- License verification -->
    <add key="Vigi.License.Path" value="%ProgramData%\\Vigitemp\\license.vtlic" />
    <add key="Vigi.License.PublicKeyPath" value="%ProgramData%\\Vigitemp\\public_key.pem" />
    <!-- Optional: used to enforce binding when license includes bind.instancePublicKey -->
    <add key="Vigi.License.InstancePublicKey" value="" />

    <!-- Database configuration (avoid hardcoding credentials in code) -->
    <add key="Vigi.Db.Provider" value="mysql" />
    <add key="Vigi.Db.Host" value="192.168.63.144" />
    <add key="Vigi.Db.Port" value="3306" />
    <add key="Vigi.Db.User" value="root" />
    <add key="Vigi.Db.Password" value="" />
    <add key="Vigi.Db.MainDatabase" value="vigitemp" />
    <add key="Vigi.Db.MeasureDatabase" value="vigitemp_mesure" />
    <add key="Vigi.Db.ConnectionTimeoutSeconds" value="5" />
    <add key="Vigi.Db.CommandTimeoutSeconds" value="30" />
    <!-- SQL Server-specific options (only applies when Vigi.Db.Provider = sqlserver) -->
    <add key="Vigi.Db.SqlServer.Encrypt" value="false" />
    <add key="Vigi.Db.SqlServer.TrustServerCertificate" value="true" />
  </appSettings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-6.0.3.0" newVersion="6.0.3.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.IO.Pipelines" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-10.0.0.1" newVersion="10.0.0.1" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Google.Protobuf" publicKeyToken="a7d26565bac4d604" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.33.4.0" newVersion="3.33.4.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="ZstdSharp" publicKeyToken="8d151af33a4ad5cf" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-0.8.7.0" newVersion="0.8.7.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.0.5.0" newVersion="4.0.5.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Threading.Tasks.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-4.2.4.0" newVersion="4.2.4.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
